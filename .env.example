# Backend is Supabase (Postgres + Auth + Storage + Edge Functions).
# See apps/web/.env.example for the frontend Supabase config, and
# supabase/functions/api for the Edge Function that replaced apps/api.

SUPABASE_URL=https://kulmcujbxkjjpppyorxp.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key is only used inside Supabase Edge Functions (set as a
# Supabase project secret) — never expose it to the frontend.
