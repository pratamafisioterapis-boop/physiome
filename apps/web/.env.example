VITE_SUPABASE_URL=https://kulmcujbxkjjpppyorxp.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Public half of the VAPID key pair used for Web Push chat notifications.
# Generate with e.g. `npx web-push generate-vapid-keys`; set the matching
# VAPID_PRIVATE_KEY (+ VAPID_PUBLIC_KEY, VAPID_CONTACT_EMAIL) as Supabase Edge
# Function secrets — never commit the private key.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
